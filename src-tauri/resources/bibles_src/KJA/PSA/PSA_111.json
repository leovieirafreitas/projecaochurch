{
  "id": "PSA.111",
  "content": "<div class=\"yv-content\"><span class=\"verse\" data-usfm=\"PSA.111.1\"><span class=\"label\">1</span><span class=\"content\"> Aleluia! De todo o coração, louvarei ao SENHOR, </span></span> <span class=\"verse\" data-usfm=\"PSA.111.2\"><span class=\"label\">2</span><span class=\"content\"> Portentosas são as obras do SENHOR, </span></span> <span class=\"verse\" data-usfm=\"PSA.111.3\"><span class=\"label\">3</span><span class=\"content\"> Os feitos do Eterno são magníficos e majestosos, </span></span> <span class=\"verse\" data-usfm=\"PSA.111.4\"><span class=\"label\">4</span><span class=\"content\"> Ele fez memoráveis as suas maravilhas; </span></span> <span class=\"verse\" data-usfm=\"PSA.111.5\"><span class=\"label\">5</span><span class=\"content\"> Provê o sustento dos que o temem; </span></span> <span class=\"verse\" data-usfm=\"PSA.111.6\"><span class=\"label\">6</span><span class=\"content\"> Revelou a seu povo suas obras grandiosas, </span></span> <span class=\"verse\" data-usfm=\"PSA.111.7\"><span class=\"label\">7</span><span class=\"content\"> As realizações de suas mãos são verdadeiras e justas, </span></span> <span class=\"verse\" data-usfm=\"PSA.111.8\"><span class=\"label\">8</span><span class=\"content\"> são firmes para todo o sempre, </span></span> <span class=\"verse\" data-usfm=\"PSA.111.9\"><span class=\"label\">9</span><span class=\"content\"> Ele trouxe redenção a seu povo, </span></span> <span class=\"verse\" data-usfm=\"PSA.111.10\"><span class=\"label\">10</span><span class=\"content\"> O temor do SENHOR é o princípio da sabedoria; </span></span> </div>",
  "reference": "KJA PSA 111"
}