{
  "name": "projection-church",
  "version": "0.3.48",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently -k \"cross-env CONFIG_FILE=.env.local next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "next build && electron-builder",
    "dist": "npm run electron:build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.91.1",
    "@tauri-apps/api": "^1.6.0",
    "@tauri-apps/plugin-sql": "^2.3.1",
    "formidable": "^3.5.4",
    "next": "16.1.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@tauri-apps/cli": "^1.6.3",
    "@types/node": "^20.19.30",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.chamachurch.biblia",
    "productName": "Projection Church",
    "files": [
      "out/**/*",
      "public/**/*",
      "electron/**/*",
      "songs_db.json",
      "package.json",
      "node_modules/**/*",
      "!node_modules/next",
      "!node_modules/typescript",
      "!node_modules/@types",
      "!node_modules/eslint*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "asar": true
  }
}